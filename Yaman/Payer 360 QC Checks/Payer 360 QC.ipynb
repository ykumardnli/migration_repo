   "source": [
    "CREATE OR REPLACE TEMP VIEW payer_base AS\n",
    "SELECT DISTINCT\n",
    "    PAYER_ID,\n",
    "    PAYER_NAME,\n",
    "    PARENT_ID,\n",
    "    PARENT_NAME,\n",
    "    KH_PLAN_ID      AS PLAN_ID,\n",
    "    INSURANCE_GROUP\n",
    "FROM com_edp_prd.com_raw.kom_plans\n",
    "WHERE PAYER_ID IS NOT NULL; \n",
    "\n",
    "SELECT count(distinct plan_id) FROM payer_base;"
   ]
